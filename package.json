{
  "name": "dsh-dual-brain-live",
  "version": "0.1.0",
  "private": true,
  "description": "双脑热切换：在 设置 → Models 页面底部配置「思考/规划脑」与「执行脑」的模型，主脑通过 delegate 工具按当前配置派活。",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/liuNNW/dsh-shuangnao.git"
  },
  "homepage": "https://github.com/liuNNW/dsh-shuangnao#readme",
  "bugs": {
    "url": "https://github.com/liuNNW/dsh-shuangnao/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./agent": "./lib/agent.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "license": "MIT"
}
